# Эти результаты сборки, зависимости и пакеты не включаем в историю Git.
out
dist
node_modules
.vscode-test/
*.vsix

# Локальные настройки и секреты
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.pfx

